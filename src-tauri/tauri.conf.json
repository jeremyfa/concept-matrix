{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Concept Matrix",
  "version": "0.1.0",
  "identifier": "jeremyfa.concept-matrix",
  "build": {
    "frontendDist": "../dist/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Concept Matrix",
        "width": 1000,
        "height": 700,
        "minWidth": 520,
        "minHeight": 400,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false,

        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 20 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Concept Matrix",
    "longDescription": "A starter kit for Haxe applications that run both in a browser and as a desktop app.",
    "copyright": "",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "../lib/wisdom-kit/tauri/entitlements.plist",
      "exceptionDomain": ""
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
