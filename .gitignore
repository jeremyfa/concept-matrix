# Node
node_modules/
*.log

# Haxe: project-local haxelib repo. Holds absolute machine paths, and is
# regenerated by `npm run setup` (which npm install runs for you).
.haxelib/

# All build output. ONE entry, because everything generated lives under dist/:
# dist/web (haxe + tailwind + static copy, which is also Tauri's frontendDist)
# and dist/bundles (the distributables). `rm -rf dist` is a complete clean, and
# adding a new generated asset can never silently become a commit.
/dist/

# Rust / Tauri
/src-tauri/target/
/src-tauri/gen/schemas/

# Signing credentials. See .env.signing.example. NEVER commit these.
.env.signing
.env.signing.local

# Editors / OS
.DS_Store
.idea/
.vscode/settings.json
.vscode/settings.local.json

# This machine's local checkouts of the kit and its libraries, used instead of
# the submodules. See lib/wisdom-kit/template/project.local.sh.example and
# `npm run sync-local`.
project.local.sh
