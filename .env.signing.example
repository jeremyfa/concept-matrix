# Apple signing credentials for the macOS build.
#
#     cp .env.signing.example .env.signing
#
# .env.signing is gitignored and must stay that way. NEVER commit real values,
# and never paste them into an issue, a log or a chat: an app-specific
# password can sign anything under your developer account until you revoke it.
#
# The export scripts load this file with `set -a` so every assignment is
# exported, which is how tauri-bundler and notarytool see them.
#
# In CI these are GitHub repository secrets instead, with the same names, and
# there is no .env.signing at all. See .github/workflows/release.yml: it
# imports the certificate into a keychain it creates for the job and deletes
# afterwards, and skips every signing step when the secrets are absent, so
# that a fork still builds.
#
# NONE OF THIS IS NEEDED TO DEVELOP. `npm run dev` and `npm run dev:web` want
# no credentials, and `ALLOW_UNSIGNED=1 ./export-mac.sh` produces a bundle
# that runs on the machine that built it. You need these only to hand a build
# to someone else.


# The certificate's full common name, exactly as the keychain spells it.
# List what you have with:
#     security find-identity -v -p codesigning
#
# It must be a "Developer ID Application" certificate. A "Mac Developer" or
# "Apple Development" certificate signs a build that runs locally and that
# Gatekeeper refuses on every other machine.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (XXXXXXXXXX)"

# The Apple ID that owns the developer account, as an email address.
APPLE_ID="you@example.com"

# An APP-SPECIFIC password, created at https://appleid.apple.com under
# Sign-In and Security. Not your account password, which will not work and
# which you should not put in a file.
APPLE_ID_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# The ten-character team identifier, shown at
# https://developer.apple.com/account under Membership details. It is also
# the part in parentheses at the end of APPLE_SIGNING_IDENTITY.
APPLE_TEAM_ID="XXXXXXXXXX"


# Windows code signing is NOT configured here.
#
# It needs a certificate from a commercial authority, and since 2023 the key
# has to live in hardware or in a cloud signing service, so there is no
# equivalent "put the password in a file" path. Without it, SmartScreen warns
# on first launch; the app still installs and runs.
